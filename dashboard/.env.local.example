# Somente desenvolvimento local. Nunca copie os bypasses para a Vercel.
VITE_AUTH_MODE=server
VITE_DEV_SERVER_PORT=6565
ONEVIEW_LOCAL_BFF_PORT=8787

# SSO server-side local (necessário para testar o botão Entrar com SSO).
# Copie os valores reais localmente; nunca publique o client secret.
ONEVIEW_PUBLIC_ORIGIN=http://localhost:6565
ONEVIEW_ALLOWED_ORIGINS=http://localhost:6565
MICROSOFT_TENANT_ID=<ID_DO_DIRETORIO_LOCATARIO>
MICROSOFT_CLIENT_ID=<ID_DO_APLICATIVO_CLIENTE>
MICROSOFT_CLIENT_SECRET=COLOQUE_LOCALMENTE
MICROSOFT_REDIRECT_URI=http://localhost:6565/api/auth/microsoft/callback
MICROSOFT_SCOPE=openid profile email User.Read
APP_SESSION_SECRET=COLOQUE_LOCALMENTE
APP_SESSION_TTL_SEC=2592000

# Acesso de leitura: tenant Microsoft configurado + domínio corporativo.
ONEVIEW_API_AUTH_REQUIRED=true
ONEVIEW_ALLOWED_EMAIL_DOMAINS=teletex.com.br,teletex.com
ONEVIEW_ALLOW_ALL_AUTHENTICATED_ACTIONS=false

# Fonte de dados server-side
ONEVIEW_LIVE_DB_ENABLED=true
ONEVIEW_LIVE_API_ENABLED=false
ONEVIEW_SNAPSHOT_MODE=false
ONEVIEW_SNAPSHOT_FALLBACK_ENABLED=true
ONEVIEW_READ_ONLY_MODE=true
ONEVIEW_OPERATIONAL_TIMEZONE=America/Sao_Paulo
ONEVIEW_PRIMARY_DATA_SOURCE_NAME=teletex-http
# OV-P0-100: em Vercel production o BFF ignora SNAPSHOT_MODE/FALLBACK mesmo se true.
# ONEVIEW_RUNTIME_ENV=production força o mesmo gate fora da Vercel.
ONEVIEW_ACK_ENABLED=false
ONEVIEW_ACK_REQUEST_ENABLED=false
ONEVIEW_ACK_EXECUTION_ENABLED=false
ONEVIEW_ACK_ALLOWED_DATASOURCES=teletex-http

# PostgreSQL via PgBouncer corporativo. A senha deve existir somente no .env.local.
ONEVIEW_DB_HOST=bancos.teletexdev.com.br
ONEVIEW_DB_PORT=443
ONEVIEW_DB_NAME=oneview
ONEVIEW_DB_USER=oneview_vercel_readonly
POSTGRES_READONLY_PASSWORD=COLOQUE_LOCALMENTE
# Pool separado de escrita controlada. A role é fixada no BFF como oneview_actions.
ONEVIEW_ACTIONS_PASSWORD=COLOQUE_LOCALMENTE
# Compatibilidade com deploys legados: POSTGRES_ACTIONS_PASSWORD continua aceito.
ONEVIEW_ACTIONS_DB_POOL_MAX=1
ONEVIEW_DB_SSLMODE=require
ONEVIEW_DB_SSL_REJECT_UNAUTHORIZED=false
ONEVIEW_DB_POOL_MAX=2
ONEVIEW_DB_QUERY_TIMEOUT_MS=10000
ONEVIEW_DB_CONNECTION_TIMEOUT_MS=10000
ONEVIEW_DISASTER_UNACK_MINUTES=5
ONEVIEW_HIGH_UNACK_MINUTES=15
ONEVIEW_AVERAGE_UNACK_MINUTES=30
ONEVIEW_ALERT_STALE_MINUTES=15

# Sessão obrigatória: acesso somente após clique em "Entrar com SSO".
ONEVIEW_API_AUTH_REQUIRED=true

# Teste de carga local. Usa APP_SESSION_SECRET para uma sessão efêmera controlada.
# Alternativamente, defina ONEVIEW_LOAD_TEST_BEARER_TOKEN ou ONEVIEW_LOAD_TEST_COOKIE
# somente no terminal atual; o runner nunca imprime nem grava esses valores.
ONEVIEW_LOAD_BASE_URL=http://127.0.0.1:8787
ONEVIEW_LOAD_TEST_EMAIL=oneview-load-test@teletex.com.br
ONEVIEW_LOAD_TIMEOUT_MS=10000
ONEVIEW_LOAD_THINK_MS=1000
ONEVIEW_LOAD_POOL_SAMPLE_MS=500

# ServiceNow DEV (SN-P0-07 / SN-P0-17). Flag liga API + item na Sidebar.
# Timeout explícito (ms) e retries só em GET transitório (429/5xx/timeout/rede).
SERVICENOW_BASE_URL=https://SEU_INSTANCE.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TIMEOUT_MS=15000
SERVICENOW_RETRY_MAX=2
SERVICENOW_INCIDENTS_ENABLED=false
VITE_SERVICENOW_INCIDENTS_ENABLED=false
# SN-P0-33 — sys_id do caller "zabbix monitoring" no ambiente atual (obrigatório
# só para correlação alerta→INC por eventid). Sem fallback para ID de outro ambiente.
SERVICENOW_ZABBIX_MONITORING_CALLER_ID=
# Opcional: CSV de sys_ids para seeds de facet em /chamados (ex.: NOC). Preferir Aggregate/API.
SERVICENOW_CALLER_FILTER_SEEDS=
