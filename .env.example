# Frontend e autenticação
VITE_AUTH_MODE=server
ONEVIEW_SNAPSHOT_MODE=false
ONEVIEW_READ_ONLY_MODE=true
ONEVIEW_ACK_ENABLED=false
ONEVIEW_ACK_REQUEST_ENABLED=false
ONEVIEW_ACK_EXECUTION_ENABLED=false
ONEVIEW_ACK_ALLOWED_DATASOURCES=teletex-http

# Fonte live server-side e fallback seguro
ONEVIEW_LIVE_DB_ENABLED=true
ONEVIEW_LIVE_API_ENABLED=false
ONEVIEW_SNAPSHOT_FALLBACK_ENABLED=true
ONEVIEW_DB_HOST=<HOST_PGBOUNCER>
ONEVIEW_DB_PORT=443
ONEVIEW_DB_NAME=oneview
ONEVIEW_DB_USER=oneview_vercel_readonly
POSTGRES_READONLY_PASSWORD=<SENHA_SOMENTE_NA_VERCEL>
# Credencial server-side exclusiva da role fixa oneview_actions.
POSTGRES_ACTIONS_PASSWORD=<SENHA_ACTIONS_SOMENTE_NA_VERCEL>
ONEVIEW_ACTIONS_DB_POOL_MAX=1
ONEVIEW_DB_SSLMODE=require
ONEVIEW_DB_SSL_REJECT_UNAUTHORIZED=false
ONEVIEW_DB_POOL_MAX=2
ONEVIEW_DB_QUERY_TIMEOUT_MS=10000
ONEVIEW_DB_CONNECTION_TIMEOUT_MS=10000
ONEVIEW_DISASTER_UNACK_MINUTES=5
ONEVIEW_HIGH_UNACK_MINUTES=15
ONEVIEW_AVERAGE_UNACK_MINUTES=30

# Controle de acesso
ONEVIEW_API_AUTH_REQUIRED=true
ONEVIEW_ALLOWED_EMAIL_DOMAINS=teletex.com.br
ONEVIEW_ALLOWED_EMAILS=
ONEVIEW_OPERATOR_EMAILS=<EMAILS_OPERADORES_CSV>
ONEVIEW_ADMIN_EMAILS=
ONEVIEW_ALLOW_ALL_AUTHENTICATED_ACTIONS=false

# SSO Microsoft server-side
ONEVIEW_PUBLIC_ORIGIN=<ORIGEM_PUBLICA_HTTPS>
MICROSOFT_TENANT_ID=<ID_DO_DIRETORIO_LOCATARIO>
MICROSOFT_CLIENT_ID=<ID_DO_APLICATIVO_CLIENTE>
MICROSOFT_CLIENT_SECRET=<VALOR_DO_SEGREDO_SOMENTE_NA_VERCEL>
MICROSOFT_REDIRECT_URI=<ORIGEM_PUBLICA_HTTPS>/api/auth/microsoft/callback
MICROSOFT_SCOPE=openid profile email User.Read

# Sessão interna do OneView
APP_SESSION_SECRET=<SEGREDO_ALEATORIO_SOMENTE_NA_VERCEL>
APP_SESSION_TTL_SEC=2592000
