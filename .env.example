# Frontend e autenticação
VITE_AUTH_MODE=server
ONEVIEW_SNAPSHOT_MODE=false
ONEVIEW_READ_ONLY_MODE=true
ONEVIEW_OPERATIONAL_TIMEZONE=America/Sao_Paulo
ONEVIEW_PRIMARY_DATA_SOURCE_NAME=teletex-http
ONEVIEW_ACK_ENABLED=false
ONEVIEW_ACK_REQUEST_ENABLED=false
ONEVIEW_ACK_EXECUTION_ENABLED=false
ONEVIEW_ACK_ALLOWED_DATASOURCES=teletex-http

# Fonte live server-side e fallback seguro
ONEVIEW_LIVE_DB_ENABLED=true
ONEVIEW_LIVE_API_ENABLED=false
ONEVIEW_SNAPSHOT_FALLBACK_ENABLED=false
# OV-P0-100: produção (VERCEL_ENV=production) nunca serve snapshot mesmo se FALLBACK=true.
ONEVIEW_DB_HOST=<HOST_PGBOUNCER>
ONEVIEW_DB_PORT=443
ONEVIEW_DB_NAME=oneview
ONEVIEW_DB_USER=oneview_vercel_readonly
POSTGRES_READONLY_PASSWORD=<SENHA_SOMENTE_NA_VERCEL>
# Credencial server-side exclusiva da role fixa oneview_actions.
POSTGRES_ACTIONS_PASSWORD=<SENHA_ACTIONS_SOMENTE_NA_VERCEL>
ONEVIEW_ACTIONS_DB_POOL_MAX=1
ONEVIEW_DB_SSLMODE=require
ONEVIEW_DB_SSL_REJECT_UNAUTHORIZED=false
ONEVIEW_DB_POOL_MAX=2
ONEVIEW_DB_QUERY_TIMEOUT_MS=10000
ONEVIEW_DB_CONNECTION_TIMEOUT_MS=10000
ONEVIEW_DISASTER_UNACK_MINUTES=5
ONEVIEW_HIGH_UNACK_MINUTES=15
ONEVIEW_AVERAGE_UNACK_MINUTES=30
ONEVIEW_ALERT_STALE_MINUTES=15

# Controle de acesso: tenant Microsoft configurado + domínio corporativo.
ONEVIEW_API_AUTH_REQUIRED=true
ONEVIEW_ALLOWED_EMAIL_DOMAINS=teletex.com.br,teletex.com
# Quando true, todo usuário autenticado do domínio pode solicitar ações
# internas que também estejam habilitadas por suas flags específicas.
ONEVIEW_ALLOW_ALL_AUTHENTICATED_ACTIONS=false

# OV-P0-280A: pedidos ServiceNow vão somente para integration_outbox.
# Worker ServiceNow não faz parte deste card; manter false até canário aprovado.
ONEVIEW_SERVICENOW_ACTIONS_ENABLED=false
# Lista auditada de identificadores lógicos permitidos; nunca aceitar sys_id livre do browser.
ONEVIEW_SERVICENOW_ASSIGNABLE_GROUPS=
# Valores internos reais auditados para state=3 (não usar labels inventados).
ONEVIEW_SERVICENOW_HOLD_REASONS=

# SSO Microsoft server-side
ONEVIEW_PUBLIC_ORIGIN=<ORIGEM_PUBLICA_HTTPS>
# Lista de origens permitidas; o SSO retorna para o mesmo domínio acessado.
ONEVIEW_ALLOWED_ORIGINS=https://oneview-vercel.vercel.app,https://oneview.teletexdev.com.br,https://oneview.teletex.com.br
MICROSOFT_TENANT_ID=<ID_DO_DIRETORIO_LOCATARIO>
MICROSOFT_CLIENT_ID=<ID_DO_APLICATIVO_CLIENTE>
MICROSOFT_CLIENT_SECRET=<VALOR_DO_SEGREDO_SOMENTE_NA_VERCEL>
MICROSOFT_REDIRECT_URI=<ORIGEM_PUBLICA_HTTPS>/api/auth/microsoft/callback
MICROSOFT_SCOPE=openid profile email User.Read

# Sessão interna do OneView
APP_SESSION_SECRET=<SEGREDO_ALEATORIO_SOMENTE_NA_VERCEL>
APP_SESSION_TTL_SEC=2592000

# ServiceNow (SN-P0-07 / SN-P0-33). Flag liga API + item na Sidebar.
SERVICENOW_BASE_URL=https://SEU_INSTANCE.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TIMEOUT_MS=15000
SERVICENOW_RETRY_MAX=2
SERVICENOW_INCIDENTS_ENABLED=false
VITE_SERVICENOW_INCIDENTS_ENABLED=false
# sys_id do caller Zabbix no ambiente atual — obrigatório só para correlação alerta→INC.
# Sem fallback silencioso para sys_id de DEV/outro ambiente.
SERVICENOW_ZABBIX_MONITORING_CALLER_ID=
# Opcional: CSV de sys_ids para seeds de facet (ex.: NOC). Preferir Aggregate/API.
SERVICENOW_CALLER_FILTER_SEEDS=
