# OneView Vercel environment.
# Configure these values in the Vercel project settings.

# Apresentação isolada: não acessa API, PostgreSQL ou Zabbix.
NEXT_PUBLIC_DEMO_MODE=true

DATABASE_URL=postgresql://oneview_app:<PASSWORD>@192.168.254.4:6432/oneview
POSTGRES_SSL=false
PG_POOL_MAX=5

ONEVIEW_API_AUTH_REQUIRED=true
ONEVIEW_ALLOWED_EMAIL_DOMAINS=teletex.com.br
ONEVIEW_ALLOWED_EMAILS=
ONEVIEW_OPERATOR_EMAILS=
ONEVIEW_ADMIN_EMAILS=
ONEVIEW_ALLOW_ALL_AUTHENTICATED_ACTIONS=false

VITE_API_BASE_URL=
VITE_RUNTIME_BASE_HOSTS=devops.teletex.com.br
VITE_RUNTIME_BASE_HINTS=noc
VITE_DISABLE_AUTH_GUARD=false
VITE_ONEVIEW_API_AUTH_DISABLED=false

VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_AUTHORITY=
VITE_AZURE_REDIRECT_URI=
VITE_AZURE_REDIRECT_URI_LOCAL=
VITE_AZURE_POST_LOGOUT_URI=
VITE_AZURE_POST_LOGOUT_URI_LOCAL=
VITE_AZURE_SCOPES=openid profile email offline_access User.Read
VITE_MSAL_LOG_LEVEL=warning

AZURE_CLIENT_ID=
AZURE_TENANT_ID=
